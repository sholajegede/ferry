{
  "name": "ferry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,convex -c teal,yellow \"next dev\" \"convex dev\"",
    "dev:https": "concurrently -n web,convex -c teal,yellow \"next dev --experimental-https -H 0.0.0.0\" \"convex dev\"",
    "setup": "node scripts/setup.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "test": "tsx --test --test-timeout=60000 tests/*.test.ts",
    "test:bridge": "tsx tests/bridge.ts",
    "test:e2e": "node tests/e2e.mjs && node tests/e2e-extras.mjs && node tests/cli.mjs",
    "cli:build": "npm --prefix cli install && npm --prefix cli run build"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "client-zip": "^2.5.1",
    "convex": "^1.46.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "convex-test": "^0.0.60",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
