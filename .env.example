# Written by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Public address of the site, used for links, the sitemap and the CLI
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Same value here and in Convex (`npx convex env set NETWORK_SECRET ...`).
# Signs the network tokens behind "On your network now".
NETWORK_SECRET=

# Same value here and in Convex. Lets the admin page read usage totals.
ANALYTICS_KEY=

# Password for /admin, 12 characters or more
ADMIN_PASSWORD=

# Set on launch day to show a "Live on Product Hunt" banner and badge
NEXT_PUBLIC_PRODUCT_HUNT_URL=

# Shown on the privacy and terms pages when set
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=

# Optional relay for networks that block direct connections. Set these in Convex, not here.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# or
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
